<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('./partials/head') %>
        <title>Homepage</title>
</head>

<body>
    <%- include('./partials/nav') %>

        <div class="container mt-5 mb-5">
            <section class="bn-panel bn-hero text-center mb-5">
                <h1 class="bn-title">Stories worth reading</h1>
                <p class="bn-sub mb-4">Write, share and discover blogs from writers around BlogNest.</p>
                <% if (locals.user) { %>
                    <a class="btn btn-primary" href="/blog/add-new">Write a blog</a>
                    <% } else { %>
                        <a class="btn btn-primary" href="/user/signup">Get started</a>
                        <% } %>
            </section>

            <div class="d-flex align-items-center justify-content-between mb-4">
                <h2 class="bn-section-title">Latest blogs</h2>
                <span class="bn-count">
                    <%= blogs.length %> posts
                </span>
            </div>

            <% if (blogs.length===0) { %>
                <div class="bn-empty">
                    <h3 class="mb-2">No blogs yet</h3>
                    <p class="mb-0">Be the first one to write something.</p>
                </div>
                <% } else { %>
                    <div class="row g-4">
                        <% blogs.forEach(blog=> { %>
                            <div class="col-md-6 col-lg-4">
                                <div class="card h-100">
                                    <% if (blog.coverImageURL) { %>
                                        <img src="<%= blog.coverImageURL %>" class="card-img-top" alt="cover image" />
                                        <% } %>
                                            <div class="card-body d-flex flex-column">
                                                <% if (blog.createdAt) { %>
                                                    <div class="bn-meta mb-2">
                                                        <%= new Date(blog.createdAt).toLocaleDateString('en-IN', {
                                                            day: 'numeric' , month: 'short' , year: 'numeric' }) %>
                                                    </div>
                                                    <% } %>
                                                        <h5 class="card-title">
                                                            <%= blog.title %>
                                                        </h5>
                                                        <p class="bn-clamp flex-grow-1">
                                                            <%= blog.body %>
                                                        </p>
                                                        <a href="/blog/<%= blog._id %>"
                                                            class="btn btn-primary btn-sm align-self-start">Read
                                                            more</a>
                                            </div>
                                </div>
                            </div>
                            <% }) %>
                    </div>
                    <% } %>
        </div>

        <%- include('./partials/scripts') %>
</body>

</html>