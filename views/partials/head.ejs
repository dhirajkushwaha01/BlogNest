<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#e0e5ec">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap"
    rel="stylesheet">

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">

<style>
    :root {
        --bg: #e0e5ec;
        --ink: #000000;
        --sh-d: #a3b1c6;
        --sh-l: #ffffff;

        --raised: 9px 9px 18px var(--sh-d), -9px -9px 18px var(--sh-l);
        --raised-lg: 14px 14px 28px var(--sh-d), -14px -14px 28px var(--sh-l);
        --raised-sm: 5px 5px 10px var(--sh-d), -5px -5px 10px var(--sh-l);
        --inset: inset 6px 6px 12px var(--sh-d), inset -6px -6px 12px var(--sh-l);
        --inset-sm: inset 3px 3px 6px var(--sh-d), inset -3px -3px 6px var(--sh-l);

        --radius: 20px;
        --ease: cubic-bezier(0.22, 1, 0.36, 1);
    }

    html {
        scroll-behavior: smooth;
    }

    body {
        font-family: "Inter", system-ui, sans-serif;
        background: var(--bg);
        color: var(--ink);
        -webkit-font-smoothing: antialiased;
    }

    ::selection {
        background: rgba(0, 0, 0, 0.15);
    }

    h1,
    h2,
    h3,
    h4,
    h5,
    h6,
    p,
    label,
    span,
    li,
    small {
        color: var(--ink);
    }

    h1,
    h2,
    h3 {
        font-family: "Playfair Display", Georgia, serif;
        letter-spacing: -0.01em;
    }

    /* ===== Page entrance ===== */
    @keyframes bnRise {
        from {
            opacity: 0;
            transform: translateY(14px);
        }

        to {
            opacity: 1;
            transform: none;
        }
    }

    .container[class*="mt-"] {
        animation: bnRise 0.55s var(--ease) both;
    }

    /* ===== Buttons: ubhre hue, click par dab jate hain ===== */
    .btn,
    .btn.btn-primary,
    .btn.btn-secondary,
    .btn.btn-dark,
    .btn.btn-danger,
    .btn.btn-success,
    .btn.btn-outline-primary {
        background: var(--bg);
        color: var(--ink);
        border: 0;
        border-radius: 14px;
        font-weight: 600;
        padding: 0.65rem 1.4rem;
        box-shadow: var(--raised-sm);
        transition: transform 0.25s var(--ease), box-shadow 0.25s var(--ease), color 0.2s;
    }

    .btn.btn-primary {
        font-weight: 700;
    }

    .btn-sm {
        padding: 0.45rem 1rem;
        border-radius: 12px;
    }

    .btn:hover,
    .btn.btn-primary:hover,
    .btn.btn-secondary:hover,
    .btn.btn-dark:hover,
    .btn.btn-danger:hover,
    .btn.btn-success:hover,
    .btn.btn-outline-primary:hover {
        background: var(--bg);
        color: var(--ink);
        transform: translateY(-3px);
        box-shadow: var(--raised);
    }

    .btn:active,
    .btn.btn-primary:active,
    .btn.btn-secondary:active,
    .btn.btn-dark:active,
    .btn.btn-danger:active,
    .btn.btn-success:active,
    .btn.btn-outline-primary:active,
    .btn.btn-primary:focus-visible {
        background: var(--bg);
        color: var(--ink);
        transform: translateY(0);
        box-shadow: var(--inset-sm);
    }

    .btn:focus-visible {
        outline: none;
    }

    /* ===== Links ===== */
    a:not(.btn):not([class*="bn-"]):not(.dropdown-item):not(.nav-link):not(.navbar-brand) {
        color: var(--ink);
        font-weight: 600;
        text-decoration: none;
        background-image: linear-gradient(currentColor, currentColor);
        background-repeat: no-repeat;
        background-position: 0 100%;
        background-size: 0 2px;
        transition: background-size 0.3s var(--ease);
    }

    a:not(.btn):not([class*="bn-"]):not(.dropdown-item):not(.nav-link):not(.navbar-brand):hover {
        color: var(--ink);
        background-size: 100% 2px;
    }

    /* ===== Cards ===== */
    .card {
        padding: 14px;
        background: var(--bg);
        border: 0;
        border-radius: var(--radius);
        box-shadow: var(--raised);
        overflow: hidden;
        transition: transform 0.35s var(--ease), box-shadow 0.35s var(--ease);
    }

    .card[style] {
        width: 100% !important;
    }

    .card:hover {
        transform: translateY(-6px);
        box-shadow: var(--raised-lg);
    }

    .card-img-top {
        height: 190px;
        object-fit: cover;
        border-radius: 14px;
        box-shadow: var(--inset-sm);
        transition: transform 0.5s var(--ease);
    }

    .card:hover .card-img-top {
        transform: scale(1.02);
    }

    .card-body {
        padding: 1.1rem 0.4rem 0.4rem;
    }

    .card-title {
        font-family: "Playfair Display", serif;
        font-size: 1.15rem;
        font-weight: 700;
        color: var(--ink);
    }

    .card-text {
        color: var(--ink);
    }

    /* ===== Forms: andar ko dabe hue ===== */
    .form-control,
    .form-select {
        background: var(--bg);
        color: var(--ink);
        border: 0;
        border-radius: 14px;
        padding: 0.8rem 1.05rem;
        box-shadow: var(--inset);
        transition: box-shadow 0.25s var(--ease);
    }

    .form-control::placeholder {
        color: rgba(0, 0, 0, 0.5);
    }

    .form-control:hover {
        box-shadow: var(--inset), 0 0 0 1px rgba(0, 0, 0, 0.06);
    }

    .form-control:focus,
    .form-select:focus {
        background: var(--bg);
        color: var(--ink);
        outline: none;
        box-shadow: var(--inset), 0 0 0 2px rgba(0, 0, 0, 0.18);
    }

    .form-control::file-selector-button {
        background: var(--bg);
        color: var(--ink);
        border: 0;
        border-radius: 10px;
        padding: 0.4rem 0.9rem;
        margin-right: 0.9rem;
        font-weight: 600;
        box-shadow: var(--raised-sm);
    }

    .form-label {
        font-weight: 600;
        font-size: 0.9rem;
        color: var(--ink);
    }

    .form-text {
        color: rgba(0, 0, 0, 0.7);
    }

    /* ===== Alerts ===== */
    .alert {
        background: var(--bg);
        color: var(--ink);
        border: 0;
        border-radius: 16px;
        box-shadow: var(--inset-sm);
        font-weight: 500;
    }

    /* ===== Blog page ===== */
    pre {
        white-space: pre-wrap;
        word-wrap: break-word;
        font-family: "Inter", sans-serif;
        font-size: 1.05rem;
        line-height: 1.8;
        color: var(--ink);
    }

    img[width="700px"] {
        max-width: 100%;
        height: auto;
        border-radius: var(--radius);
        box-shadow: var(--raised);
    }

    @media (prefers-reduced-motion: reduce) {

        *,
        *::before,
        *::after {
            animation: none !important;
            transition: none !important;
        }
    }

    /* ===== Shared page layout ===== */
    .bn-panel {
        background: var(--bg);
        border-radius: 28px;
        padding: 2.4rem;
        box-shadow: var(--raised-lg);
    }

    .bn-panel-narrow {
        max-width: 480px;
        margin: 0 auto;
    }

    .bn-panel-wide {
        max-width: 820px;
        margin: 0 auto;
    }

    .bn-badge {
        width: 68px;
        height: 68px;
        border-radius: 50%;
        display: grid;
        place-items: center;
        margin: 0 auto 1.2rem;
        background: var(--bg);
        color: var(--ink);
        box-shadow: var(--raised);
    }

    .bn-title {
        font-family: "Playfair Display", Georgia, serif;
        font-size: 2rem;
        font-weight: 700;
        text-align: center;
        margin-bottom: 0.35rem;
    }

    .bn-sub {
        text-align: center;
        opacity: 0.7;
        margin-bottom: 1.8rem;
    }

    .bn-block {
        width: 100%;
        padding: 0.85rem 1.4rem;
        margin-top: 0.5rem;
    }

    .bn-foot {
        text-align: center;
        margin: 1.6rem 0 0;
        font-size: 0.92rem;
    }

    textarea.form-control {
        resize: vertical;
    }

    /* Home */
    .bn-hero .bn-title {
        font-size: clamp(2rem, 5vw, 2.9rem);
    }

    .bn-section-title {
        font-family: "Playfair Display", Georgia, serif;
        font-size: 1.6rem;
        font-weight: 700;
        margin: 0;
    }

    .bn-count {
        padding: 0.35rem 0.95rem;
        border-radius: 999px;
        font-size: 0.85rem;
        font-weight: 600;
        box-shadow: var(--inset-sm);
    }

    .bn-meta {
        font-size: 0.8rem;
        opacity: 0.65;
    }

    .bn-clamp {
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
        line-height: 1.6;
        font-size: 0.92rem;
        margin-bottom: 1rem;
    }

    .bn-empty {
        text-align: center;
        padding: 3rem 1.5rem;
        border-radius: 24px;
        box-shadow: var(--inset);
    }

    /* Blog page */
    .container.bn-read {
        max-width: 860px;
    }

    .bn-article-title {
        font-size: clamp(1.8rem, 4vw, 2.6rem);
        font-weight: 700;
        margin-bottom: 0.4rem;
    }

    .bn-author {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 0.9rem 1.1rem;
        margin: 1.2rem 0 1.6rem;
        border-radius: 18px;
        box-shadow: var(--inset-sm);
    }

    .bn-avatar-img {
        width: 54px;
        height: 54px;
        border-radius: 50%;
        object-fit: cover;
        flex-shrink: 0;
        box-shadow: var(--raised-sm);
    }

    .bn-author-name {
        font-weight: 700;
        line-height: 1.2;
    }

    .bn-comment {
        padding: 1.1rem 1.2rem;
        border-radius: 18px;
        box-shadow: var(--raised-sm);
    }

    .bn-comment-head {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 0.5rem;
        font-weight: 600;
    }

    .bn-comment-head .bn-avatar-img {
        width: 34px;
        height: 34px;
    }

    .bn-comment-text {
        white-space: pre-wrap;
        margin: 0;
        line-height: 1.6;
    }

    @media (max-width: 575.98px) {
        .bn-panel {
            padding: 1.6rem;
            border-radius: 22px;
        }
    }
</style>