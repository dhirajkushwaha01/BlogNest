<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('./partials/head') %>
        <title>Blog</title>

        <style>
            /* Comment section spacing fix */
            .bn-comment-head {
                margin-bottom: 4px;
                gap: 8px;
            }

            .bn-comment-text {
                margin: 0;
            }
        </style>
</head>

<body>
    <%- include('./partials/nav') %>

        <div class="container bn-read mt-5 mb-5">
            <article class="bn-panel mb-4">
                <h1 class="bn-article-title">
                    <%= blog.title %>
                </h1>
                <% if (blog.createdAt) { %>
                    <div class="bn-meta">
                        <%= new Date(blog.createdAt).toLocaleDateString('en-IN', { day: 'numeric' , month: 'long' ,
                            year: 'numeric' }) %>
                    </div>
                    <% } %>

                        <% if (blog.createdBy) { %>
                            <div class="bn-author">
                                <img class="bn-avatar-img" src="<%= blog.createdBy.profileImageURL %>" alt="author" />
                                <div>
                                    <div class="bn-meta">Written by</div>
                                    <div class="bn-author-name">
                                        <%= blog.createdBy.fullName %>
                                    </div>
                                </div>
                            </div>
                            <% } %>

                                <% if (blog.coverImageURL) { %>
                                    <img src="<%= blog.coverImageURL %>" width="700px" class="d-block mx-auto mb-4"
                                        alt="cover image" />
                                    <% } %>

                                        <pre><%= blog.body %></pre>
            </article>

            <section class="bn-panel">
                <h2 class="bn-section-title mb-4">Comments (<%= comments.length %>)</h2>

                <% if (locals.user) { %>
                    <form action="/blog/comment/<%= blog._id %>" method="post"
                        class="d-flex flex-column flex-sm-row gap-3 mb-4">
                        <input type="text" name="content" class="form-control" placeholder="Enter your comment"
                            required />
                        <button class="btn btn-primary" type="submit">Add</button>
                    </form>
                    <% } else { %>
                        <p class="mb-4"><a href="/user/signin">Sign in</a> to write a comment.</p>
                        <% } %>

                            <div class="d-flex flex-column gap-3">
                                <% comments.forEach(comment=> { %>
                                    <div class="bn-comment">
                                        <div class="bn-comment-head">
                                            <% if (comment.createdBy) { %>
                                                <img class="bn-avatar-img"
                                                    src="<%= comment.createdBy.profileImageURL %>" alt="user" />
                                                <span>
                                                    <%= comment.createdBy.fullName %>
                                                </span>
                                                <% } else { %>
                                                    <span>Deleted user</span>
                                                    <% } %>
                                        </div>
                                        <p class="bn-comment-text">
                                            <%= comment.content %>
                                        </p>
                                    </div>
                                    <% }) %>
                            </div>
            </section>
        </div>

        <%- include('./partials/scripts') %>
</body>

</html>