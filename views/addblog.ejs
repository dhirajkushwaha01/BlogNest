<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('./partials/head') %>
        <title>Add New Blog</title>
</head>

<body>
    <%- include('./partials/nav') %>

        <div class="container mt-5 mb-5">
            <div class="bn-panel bn-panel-wide">
                <div class="bn-badge">
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                        stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 20h9" />
                        <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z" />
                    </svg>
                </div>
                <h1 class="bn-title">Add Blog</h1>
                <p class="bn-sub">Share your story with the BlogNest community.</p>

                <form action="/blog" method="post" enctype="multipart/form-data">
                    <div class="mb-3">
                        <label for="title" class="form-label">Title</label>
                        <input type="text" class="form-control" id="title" name="title" aria-describedby="title"
                            required>
                    </div>

                    <div class="mb-3">
                        <label for="body" class="form-label">Body</label>
                        <textarea class="form-control" id="body" name="body" rows="8" required></textarea>
                    </div>

                    <div class="mb-4">
                        <label for="coverImage" class="form-label">Cover Image</label>
                        <input type="file" class="form-control" id="coverImage" name="coverImage" accept="image/*">
                    </div>

                    <button type="submit" class="btn btn-primary bn-block">Publish</button>
                </form>
            </div>
        </div>

        <%- include('./partials/scripts') %>
</body>

</html>